---
import { ui, type Lang } from '../lib/i18n';
import { catIcon } from '../lib/data';
interface Props { lang: Lang; cat?: string; title: string; count?: number | string; sub?: string; icon?: string | null; crumbs?: { label: string; href?: string }[]; }
const { lang, cat, title, count, sub, icon, crumbs = [] } = Astro.props;
const img = icon ?? (cat ? catIcon(cat) : null);
const trail: { label: string; href?: string }[] = [{ label: ui(lang, 'home'), href: `/${lang.slug}/` }];
if (cat) trail.push({ label: ui(lang, cat), href: crumbs.length ? `/${lang.slug}/${cat}/` : undefined });
trail.push(...crumbs);
---
<nav class="crumbs" aria-label="breadcrumb">
  {trail.map((c, i) => (<>{i > 0 && <span class="sep">›</span>}{c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</>))}
</nav>
{title && <div class="page-head">
  {img && <span class="slot"><img src={`/sprites/${img}`} alt="" /></span>}
  <div>
    <h1>{title}{count !== undefined && count !== '' && <span class="count">{count}</span>}</h1>
    {sub && <p>{sub}</p>}
  </div>
</div>}
