---
import '../styles/global.css';
import { LANGS, ui, type Lang } from '../lib/i18n';
import { NAV_GROUPS, ALL_CATS, catIcon, LINKS } from '../lib/data';
import LangMenu from '../components/LangMenu.astro';
interface Props { lang: Lang; title: string; description?: string; path?: string; spoiler?: boolean; }
const { lang, title, description, path = '', spoiler = false } = Astro.props;
const t = (k: string) => ui(lang, k);
const fullTitle = title ? `${title} · ${t('siteTitle')}` : t('siteTitle');
const here = Astro.url.pathname;
const isActive = (cat: string) => here.startsWith(`/${lang.slug}/${cat}/`);
const searchCats = Object.fromEntries(ALL_CATS.map((c) => [c, { label: t(c), icon: catIcon(c) }]));
const searchTexts = { placeholder: t('search'), nav: t('kbdNav'), open: t('kbdOpen'), close: t('kbdClose'), empty: t('noResults'), loading: t('searching'), browse: t('searchTry'), count: t('resultsCount') };
---
<!doctype html>
<html lang={lang.html} data-spoilers="off">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? t('tagline')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description ?? t('tagline')} />
    <meta property="og:image" content="/brand/banner.webp" />
    <meta name="theme-color" content="#0b1417" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;600;700&display=swap" />
    {LANGS.map((l) => <link rel="alternate" hreflang={l.html} href={`/${l.slug}/${path}`} />)}
    <script is:inline>
      try { document.documentElement.dataset.spoilers = localStorage.getItem('bloomrise-spoilers') === 'on' ? 'on' : 'off'; } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href={`/${lang.slug}/`} aria-label="Tales Of Bloomrise Wiki"><img src="/brand/logo.png" alt="Tales Of Bloomrise" /><span class="wiki">Wiki</span></a>

        <nav class="nav" id="nav" aria-label="main">
          {NAV_GROUPS.map((grp) => (
            <div class={`nav-group ${grp.cats.some(isActive) ? 'active' : ''}`}>
              <button type="button" aria-haspopup="true">{t(grp.key)}</button>
              <div class="menu">
                {grp.cats.map((c) => (
                  <a href={`/${lang.slug}/${c}/`} aria-current={isActive(c) ? 'page' : undefined}>
                    {catIcon(c) && <img src={`/sprites/${catIcon(c)}`} alt="" />}{t(c)}
                  </a>
                ))}
              </div>
            </div>
          ))}
          <a href={`/${lang.slug}/mechanics/`} aria-current={isActive('mechanics') ? 'page' : undefined}>{t('mechanics')}</a>
          <div class="nav-tools">
            <button class="btn js-spoiler" type="button" aria-pressed="false">👁 {t('spoilers')}</button>
          </div>
          <div class="nav-langs"><LangMenu lang={lang} path={path} variant="grid" /></div>
        </nav>

        <span class="spacer"></span>
        <button class="search-btn" id="open-search" type="button" aria-label={t('search')}>
          <span aria-hidden="true">🔍</span><span class="label">{t('search')}</span><kbd>/</kbd>
        </button>
        <button class="btn js-spoiler desk" type="button" aria-pressed="false" title={t('spoilersHint')}>👁 <span class="lbl">{t('spoilers')}</span></button>
        <span class="desk"><LangMenu lang={lang} path={path} /></span>
        <button class="btn burger" id="burger" type="button" aria-label={t('menu')} aria-expanded="false">☰</button>
      </div>
    </header>

    <main id="main" data-pagefind-body data-pagefind-meta={spoiler ? 'spoiler:1' : undefined}>
      <slot />
    </main>

    <footer>
      <div class="cols">
        <div>
          <img src="/brand/logo.png" alt="Tales Of Bloomrise" style="height:36px; margin-bottom:.6rem" />
          <p>{t('footer')}</p>
          <p class="flinks">
            <a href={LINKS.site}>{t('official')}</a>
            <a href={LINKS.steam} rel="noopener">Steam</a>
            <a href={LINKS.play} rel="noopener">Google Play</a>
            <a href={LINKS.discord} rel="noopener">Discord</a>
          </p>
        </div>
        {NAV_GROUPS.map((grp) => (
          <div>
            <h4>{t(grp.key)}</h4>
            <ul>{grp.cats.map((c) => <li><a href={`/${lang.slug}/${c}/`}>{t(c)}</a></li>)}</ul>
          </div>
        ))}
      </div>
      <div class="legal"><span>© Whiskline Studio</span><a href={`/${lang.slug}/mechanics/`}>{t('mechanics')}</a></div>
    </footer>
    <button class="to-top" id="to-top" type="button" aria-label={t('top')}>↑</button>

    <dialog id="search-dialog" aria-label={t('search')}>
      <div class="sbox">
        <div class="s-input">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M15.5 15.5L21 21" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
          <input id="s-q" type="search" autocomplete="off" spellcheck="false" placeholder={t('search')} aria-label={t('search')} />
          <button type="button" class="s-esc" id="s-close" aria-label={t('kbdClose')}>Esc</button>
        </div>
        <div id="s-body" class="s-body"></div>
        <div class="s-foot"><span><kbd>↑</kbd><kbd>↓</kbd> {t('kbdNav')}</span><span><kbd>↵</kbd> {t('kbdOpen')}</span><span><kbd>Esc</kbd> {t('kbdClose')}</span></div>
      </div>
    </dialog>

    <script is:inline define:vars={{ lang: lang.slug, searchCats, searchTexts }}>
      const html = document.documentElement;
      const sps = [...document.querySelectorAll('.js-spoiler')];
      const sync = () => sps.forEach((b) => b.setAttribute('aria-pressed', html.dataset.spoilers === 'on' ? 'true' : 'false'));
      sync();
      sps.forEach((sp) => sp.addEventListener('click', () => {
        const on = html.dataset.spoilers !== 'on';
        html.dataset.spoilers = on ? 'on' : 'off';
        try { localStorage.setItem('bloomrise-spoilers', on ? 'on' : 'off'); } catch (e) {}
        sync();
      }));
      // menu de idiomas (desktop)
      const lm = document.querySelector('.lang-menu');
      if (lm) {
        const lb = lm.querySelector('.lang-btn');
        lb.addEventListener('click', (e) => { e.stopPropagation(); const o = lm.classList.toggle('open'); lb.setAttribute('aria-expanded', o ? 'true' : 'false'); });
        document.addEventListener('click', () => { lm.classList.remove('open'); lb.setAttribute('aria-expanded', 'false'); });
        addEventListener('keydown', (e) => { if (e.key === 'Escape') lm.classList.remove('open'); });
      }

      // menus (clique funciona em toque; hover em desktop via CSS)
      const groups = [...document.querySelectorAll('.nav-group')];
      groups.forEach((g) => g.querySelector('button').addEventListener('click', (e) => {
        e.stopPropagation(); const was = g.classList.contains('open'); groups.forEach((x) => x.classList.remove('open')); if (!was) g.classList.add('open');
      }));
      document.addEventListener('click', () => groups.forEach((x) => x.classList.remove('open')));
      const burger = document.getElementById('burger'), nav = document.getElementById('nav');
      const setNav = (o) => { nav.classList.toggle('open', o); document.body.classList.toggle('nav-open', o); burger.setAttribute('aria-expanded', o ? 'true' : 'false'); burger.textContent = o ? '✕' : '☰'; };
      burger.addEventListener('click', (e) => { e.stopPropagation(); setNav(!nav.classList.contains('open')); });
      nav.addEventListener('click', (e) => e.stopPropagation());
      document.addEventListener('click', () => setNav(false));
      addEventListener('keydown', (e) => { if (e.key === 'Escape') { setNav(false); groups.forEach((x) => x.classList.remove('open')); } });
      addEventListener('resize', () => { if (innerWidth > 960) setNav(false); });

      const toTop = document.getElementById('to-top');
      addEventListener('scroll', () => toTop.classList.toggle('show', scrollY > 600), { passive: true });
      toTop.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));

      // ---------- busca (Pagefind via API, interface propria) ----------
      const dlg = document.getElementById('search-dialog');
      const qIn = document.getElementById('s-q');
      const body = document.getElementById('s-body');
      let pf = null, seq = 0, active = -1, timer;
      const esc = (x) => String(x).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      const catOf = (url) => { const seg = url.split('/').filter(Boolean); return seg.length > 1 ? seg[1] : ''; };
      const catChips = () => '<p class="s-label">' + esc(searchTexts.browse) + '</p><div class="s-chips">' + Object.entries(searchCats).map(([c, v]) =>
        '<a class="s-chip" href="/' + lang + '/' + c + '/">' + (v.icon ? '<img class="px" src="/sprites/' + v.icon + '" alt="">' : '') + esc(v.label) + '</a>').join('') + '</div>';
      const showHome = () => { body.innerHTML = catChips(); active = -1; };
      const setActive = (i) => {
        const items = [...body.querySelectorAll('.s-item')]; if (!items.length) return;
        active = (i + items.length) % items.length;
        items.forEach((el, k) => el.classList.toggle('on', k === active));
        items[active].scrollIntoView({ block: 'nearest' });
      };
      async function run(q) {
        const my = ++seq;
        if (!q.trim()) return showHome();
        body.innerHTML = '<p class="s-msg">' + esc(searchTexts.loading) + '</p>';
        try {
          if (!pf) { pf = await import('/pagefind/pagefind.js'); }
          const res = await pf.search(q);
          if (my !== seq) return;
          const rows = await Promise.all(res.results.slice(0, 12).map((r) => r.data()));
          if (my !== seq) return;
          if (!rows.length) { body.innerHTML = '<p class="s-msg">' + esc(searchTexts.empty) + '</p>'; return; }
          body.innerHTML = '<p class="s-label">' + esc(searchTexts.count.replace('{n}', res.results.length)) + '</p>' + rows.map((d) => {
            const c = catOf(d.url), cat = searchCats[c];
            const img = (d.meta && d.meta.image) || (cat && cat.icon ? '/sprites/' + cat.icon : '');
            const spoiler = d.meta && d.meta.spoiler ? ' spoiler' : '';
            const title = ((d.meta && d.meta.title) || '').replace(/\s*·.*$/, '');
            return '<a class="s-item' + spoiler + '" href="' + d.url + '">' +
              '<span class="s-ico">' + (img ? '<img class="px" src="' + img + '" alt="">' : '') + '</span>' +
              '<span class="s-txt">' + (cat ? '<span class="s-cat">' + esc(cat.label) + '</span>' : '') + '<b>' + esc(title) + '</b><span class="s-ex">' + d.excerpt + '</span></span></a>';
          }).join('');
          setActive(0);
        } catch (e) {
          body.innerHTML = '<p class="s-msg">Search is available after a production build (npm run build).</p>';
        }
      }
      function openSearch() {
        dlg.showModal(); qIn.value = ''; showHome();
        setTimeout(() => qIn.focus(), 30);
      }
      qIn.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(() => run(qIn.value), 140); });
      qIn.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
        else if (e.key === 'Enter') { const el = body.querySelectorAll('.s-item')[active]; if (el) { e.preventDefault(); location.href = el.getAttribute('href'); } }
      });
      document.getElementById('s-close').addEventListener('click', () => dlg.close());
      document.querySelectorAll('#open-search, [data-open-search]').forEach((b) => b.addEventListener('click', openSearch));
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      addEventListener('keydown', (e) => { if (e.key === '/' && !/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)) { e.preventDefault(); openSearch(); } });
    </script>
  </body>
</html>
