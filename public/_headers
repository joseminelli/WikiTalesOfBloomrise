# Cache longo para arquivos que so mudam quando regeneramos o site (Cloudflare Pages / Netlify)
/sprites/*
  Cache-Control: public, max-age=2592000
/flags/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/brand/*
  Cache-Control: public, max-age=2592000
/img/*
  Cache-Control: public, max-age=2592000
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
