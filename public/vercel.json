{
  "trailingSlash": true,
  "headers": [
    { "source": "/(sprites|brand|img)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/(flags|fonts|_astro)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
